{
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "editor.formatOnSave": true,
    "errorLens.onSave": true,
    "[typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome"
    },
    // Biome is installed per frontend, not at the repo root; both frontends pin the same version.
    "biome.lsp.bin": "public-redesign/node_modules/@biomejs/biome/bin/biome",
    // Large or constantly changing local data that VS Code should not watch.
    "files.watcherExclude": {
        "db-pg/data*/**": true,
        "redis/**": true,
        "logs/**": true,
        "django/logs/**": true,
        ".pnpm-store/**": true
    },
    "snyk.advanced.autoSelectOrganization": true,
    "python-envs.defaultEnvManager": "ms-python.python:system",
}