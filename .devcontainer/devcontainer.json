{
  "name": "Democracy Sausage",
  "dockerComposeFile": ["../docker-compose.yml", "compose.yml"],
  "service": "django",
  "runServices": [
    "db",
    "redis",
    "memcached",
    "memcached_gui",
    "django",
    "python_rq_worker",
    "rq_dashboard",
    "frontend_public_redesign",
    "frontend_admin_redesign",
    "nginx"
  ],
  "workspaceFolder": "/workspaces/demsausage",
  "mounts": [
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind"
  ],
  "containerEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22.23.4",
      "pnpmVersion": "9.12.2"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "28.5.2",
      "dockerDashComposeVersion": "v2"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "biomejs.biome",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": ["/app"],
        "python.analysis.typeCheckingMode": "basic",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.testing.cwd": "${workspaceFolder}/django",
        "ruff.path": ["/usr/local/bin/ruff"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  }
}
